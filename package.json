{
  "name": "@avenzoq/probe",
  "version": "0.6.1",
  "description": "Red-team your AI agents, MCP servers and skills before attackers do: tool poisoning, prompt injection, excessive agency, leaked secrets.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-security",
    "prompt-injection",
    "tool-poisoning",
    "llm",
    "agents",
    "red-team",
    "claude-code",
    "owasp"
  ],
  "homepage": "https://github.com/MaikolSoro/probe#readme",
  "bugs": {
    "url": "https://github.com/MaikolSoro/probe/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaikolSoro/probe.git"
  },
  "license": "Apache-2.0",
  "author": "AVENZOQ",
  "type": "module",
  "main": "src/cli.mjs",
  "bin": {
    "probe": "src/cli.mjs",
    "avenzoq-probe": "src/cli.mjs"
  },
  "files": [
    "src",
    "assets",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "demo:mcp": "node src/cli.mjs mcp --call-readonly --out reports/demo-mcp -- node examples/vulnerable-mcp-server.mjs",
    "demo:agent": "node src/cli.mjs agent --url http://localhost:8787/chat --history-field messages --out reports/demo-agent",
    "bench": "node bench/run.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  }
}
